{
  "name": "@lilflexer/task-flow-cli",
  "version": "1.4.0",
  "description": "Global GitHub and ClickUp task workflow CLI",
  "type": "module",
  "bin": {
    "task-flow": "./dist/index.js",
    "tf": "./dist/index.js",
    "tfs": "./dist/start.js",
    "tfsub": "./dist/submit.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
